# URL công khai của app (dùng cho metadata, callback, v.v.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL cho API backend (nếu tách riêng backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (ví dụ nếu dùng Prisma/Postgres)
DATABASE_URL=

# Auth (ví dụ NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Các key khác
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
